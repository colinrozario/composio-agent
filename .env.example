# Free setup: no paid API credits.
# Brain: Gemini free tier (key: https://aistudio.google.com/apikey). Hands: Composio SDK tools.
# Comma-separated pool: Flash-Lite models have ~500 free requests/day each (Flash preview only 20)
MODEL_PRIMARY=gemini-3.5-flash-lite,gemini-3.1-flash-lite
# Second opinion: Claude Code CLI (`claude -p`) on a Claude subscription, no API credits.
MODEL_SECONDARY=sonnet
GEMINI_API_KEY=
# Free Composio key (platform.composio.dev -> Settings -> API keys). Required: the agent's hands.
COMPOSIO_API_KEY=
COMPOSIO_BASE_URL=https://backend.composio.dev
CONCURRENCY=3
CLI_CONCURRENCY=2
COMPOSIO_RPS=1.5
GEMINI_CONCURRENCY=2
