# Free setup: no paid API credits.
# Pass 1 + grounded re-ask run through the Claude Code CLI on your Claude subscription (run `claude` once to log in).
MODEL_PRIMARY=sonnet
# Second-opinion model: Gemini free tier. Key: https://aistudio.google.com/apikey
MODEL_SECONDARY=gemini-2.5-flash
GEMINI_API_KEY=
# Free Composio key (platform.composio.dev -> Settings -> API keys). Optional: pass 0 is skipped without it.
COMPOSIO_API_KEY=
COMPOSIO_BASE_URL=https://backend.composio.dev
CONCURRENCY=3
CLI_CONCURRENCY=3
GEMINI_CONCURRENCY=2
